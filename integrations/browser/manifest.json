{
 "manifest_version":3,"name":"Lossy · Keep my drafts","version":"0.1.0",
 "description":"Save drafts on websites you choose to your local Lossy archive.",
 "key":"",
 "permissions":["nativeMessaging","storage","scripting","activeTab"],
 "optional_host_permissions":["https://*/*","http://localhost/*","http://127.0.0.1/*"],
 "background":{"service_worker":"worker.js"},
 "action":{"default_popup":"popup.html","default_title":"Lossy draft saving"},
 "incognito":"not_allowed"
}
